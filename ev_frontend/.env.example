# Default: same-origin API through the Vite dev/preview proxy. Restart after changes.
VITE_API_BASE=/api/v1
# Server-side proxy target; use IPv4 to match the Uvicorn bind address.
EV_API_TARGET=http://127.0.0.1:8000
# For a separately hosted API, set VITE_API_BASE=http://127.0.0.1:8000/api/v1
# and allow the frontend's origin in backend EV_CORS_ORIGINS.
# VITE_* variables are public. Never put secret API keys here.
