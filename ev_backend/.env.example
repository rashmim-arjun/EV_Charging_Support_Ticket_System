# Optional backend settings. These are not read automatically: pass
# --env-file ev_backend/.env to Uvicorn, or export them in your shell.
# Relative database paths resolve from the directory where Uvicorn starts.
# Leave unset to use DP-main/ev_diagnosis.db, independent of working directory.
# EV_DB_PATH=C:/path/to/ev_diagnosis.db
EV_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# No OPENAI_API_KEY, GEMINI_API_KEY, external AI service, or paid API is required.
# Diagnosis uses local rules and stored observations. Missing logs produce an
# inconclusive result and requests for evidence, never an invented AI response.
